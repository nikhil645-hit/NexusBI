# ==============================================================================
# warehouse/.env.example - Local Warehouse Environment Template
# Copy this file to warehouse/.env:
#   cp warehouse/.env.example warehouse/.env
# ==============================================================================

# Admin / superuser for the Postgres 16 data warehouse container
WAREHOUSE_ADMIN_USER=postgres
WAREHOUSE_ADMIN_PASSWORD=your_warehouse_admin_password_here
WAREHOUSE_DB=warehouse
WAREHOUSE_PORT=5434

