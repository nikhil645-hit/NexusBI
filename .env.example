# ==============================================================================
# .env.example - Master Environment Configuration Template
# Copy this file to .env:
#   cp .env.example .env
# Fill in your values before running components. Placeholders are provided below.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. LOCAL POSTGRES SOURCE (Olist e-commerce transactional database)
# Used by: source/docker-compose.yml, source/load_olist.py, and Airbyte Source config
# Port: 5433
# ------------------------------------------------------------------------------
PG_HOST=localhost
PG_PORT=5433
PG_DB=olist
PG_USER=olist
PG_PASSWORD=your_local_postgres_password_here

# ------------------------------------------------------------------------------
# 2. LOCAL POSTGRES DATA WAREHOUSE (Port 5434)
# Used by: warehouse/docker-compose.yml, sql/, dbt profiles.yml, app/
# Replaces Amazon Redshift for 100% local, zero-cloud development
# ------------------------------------------------------------------------------
WAREHOUSE_HOST=localhost
WAREHOUSE_PORT=5434
WAREHOUSE_DB=warehouse

# Superuser / Admin (used to run sql/ scripts to create schemas and users)
WAREHOUSE_ADMIN_USER=postgres
WAREHOUSE_ADMIN_PASSWORD=your_warehouse_admin_password_here

# Dedicated dbt user (created via sql/02_users.sql, has write to staging/marts, read to raw)
WAREHOUSE_DBT_USER=dbt_user
WAREHOUSE_DBT_PASSWORD=your_dbt_user_password_here

# Dedicated read-only application user (created via sql/02_users.sql, SELECT on marts only)
WAREHOUSE_APP_USER=app_readonly
WAREHOUSE_APP_PASSWORD=your_app_readonly_password_here

# ------------------------------------------------------------------------------
# 3. AIRBYTE OSS API & ORCHESTRATION
# Used by: Airflow DAG to trigger sync programmatically
# ------------------------------------------------------------------------------
# Airbyte local instance URL (from host: localhost:8000; from containers: host.docker.internal:8000)
AIRBYTE_API_URL=http://localhost:8000/api/v1
# From Airbyte UI: Settings -> Applications -> New Application
AIRBYTE_CLIENT_ID=your_airbyte_client_id_here
AIRBYTE_CLIENT_SECRET=your_airbyte_client_secret_here
# From Airbyte UI: Connections -> Olist Source to Warehouse -> URL ID
AIRBYTE_CONNECTION_ID=your_airbyte_connection_uuid_here

# ------------------------------------------------------------------------------
# 4. APACHE AIRFLOW CONFIGURATION
# Used by: airflow/docker-compose.yml
# ------------------------------------------------------------------------------
AIRFLOW_UID=50000
AIRFLOW_PROJ_DIR=.
AIRFLOW__CORE__LOAD_EXAMPLES=False

# ------------------------------------------------------------------------------
# 5. CONVERSATIONAL BI APP (Streamlit + LLM)
# Used by: app/streamlit_app.py
# ------------------------------------------------------------------------------
# Switchable LLM provider: 'gemini' or 'anthropic' (or leave empty for built-in Mock)
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Streamlit Port
STREAMLIT_SERVER_PORT=8501

# ------------------------------------------------------------------------------
# 6. (OPTIONAL) AWS REDSHIFT CLOUD WAREHOUSE & S3 STAGING
# Un-comment only if demonstrating on AWS Redshift Serverless
# ------------------------------------------------------------------------------
# AWS_REGION=ap-south-1
# AWS_ACCESS_KEY_ID=your_aws_access_key_id_here
# AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here
# REDSHIFT_HOST=olist-wg.xxxxxx.ap-south-1.redshift-serverless.amazonaws.com
# REDSHIFT_PORT=5439
# REDSHIFT_DB=dev
# REDSHIFT_ADMIN_USER=awsadmin
# REDSHIFT_ADMIN_PASSWORD=your_admin_password_here
# REDSHIFT_DBT_USER=dbt_user
# REDSHIFT_DBT_PASSWORD=your_dbt_user_password_here
# REDSHIFT_APP_USER=app_readonly
# REDSHIFT_APP_PASSWORD=your_app_readonly_password_here
# S3_BUCKET_NAME=your-airbyte-staging-bucket
