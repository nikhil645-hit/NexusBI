# ==============================================================================
# .env.example - Master Environment Configuration Template
# Copy this file to .env:
#   cp .env.example .env
# Fill in your values before running components. Placeholders are provided below.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. LOCAL POSTGRES SOURCE (Olist e-commerce database)
# Used by: source/docker-compose.yml, source/load_olist.py, and Airbyte Source config
# ------------------------------------------------------------------------------
PG_HOST=localhost
PG_PORT=5433
PG_DB=olist
PG_USER=olist
PG_PASSWORD=your_local_postgres_password_here

# ------------------------------------------------------------------------------
# 2. AWS & REDSHIFT SERVERLESS DATA WAREHOUSE
# Used by: docs/aws_setup.md, sql scripts, dbt profiles.yml, app/
# Region: ap-south-1 (Asia Pacific - Mumbai)
# ------------------------------------------------------------------------------
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here

# Redshift Serverless Workgroup Endpoint (Host) and Port (Default: 5439)
# Format: <workgroup-name>.<account-id>.<region>.redshift-serverless.amazonaws.com
REDSHIFT_HOST=olist-workgroup.123456789012.ap-south-1.redshift-serverless.amazonaws.com
REDSHIFT_PORT=5439
REDSHIFT_DB=dev

# Redshift Admin / Superuser (Used to execute sql/ scripts to create schemas and users)
REDSHIFT_ADMIN_USER=admin
REDSHIFT_ADMIN_PASSWORD=your_admin_password_here

# Dedicated dbt user (created via sql/02_users.sql, has write to staging/marts, read to raw)
REDSHIFT_DBT_USER=dbt_user
REDSHIFT_DBT_PASSWORD=your_dbt_user_password_here

# Dedicated read-only application user (created via sql/02_users.sql, SELECT on marts only)
REDSHIFT_APP_USER=app_readonly
REDSHIFT_APP_PASSWORD=your_app_readonly_password_here

# AWS S3 Bucket for Airbyte staging (Airbyte uses S3 COPY command into Redshift for speed)
S3_BUCKET_NAME=olist-airbyte-staging-bucket-mumbai

# ------------------------------------------------------------------------------
# 3. AIRBYTE OSS API & ORCHESTRATION
# Used by: Airflow DAG to trigger sync programmatically
# ------------------------------------------------------------------------------
# Airbyte local instance URL (from host or container)
AIRBYTE_API_URL=http://localhost:8000/api/v1
# From Airbyte UI: Settings -> Applications -> New Application
AIRBYTE_CLIENT_ID=your_airbyte_client_id_here
AIRBYTE_CLIENT_SECRET=your_airbyte_client_secret_here
# From Airbyte UI: Connections -> Olist Postgres to Redshift -> URL ID
AIRBYTE_CONNECTION_ID=your_airbyte_connection_uuid_here

# ------------------------------------------------------------------------------
# 4. APACHE AIRFLOW CONFIGURATION
# Used by: airflow/docker-compose.yml
# ------------------------------------------------------------------------------
AIRFLOW_UID=50000
AIRFLOW_PROJ_DIR=.
AIRFLOW__CORE__LOAD_EXAMPLES=False

# ------------------------------------------------------------------------------
# 5. CONVERSATIONAL BI APP (Streamlit + LLM)
# Used by: app/streamlit_app.py
# ------------------------------------------------------------------------------
# Switchable LLM provider: 'gemini' or 'anthropic'
LLM_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Streamlit Port
STREAMLIT_SERVER_PORT=8501

