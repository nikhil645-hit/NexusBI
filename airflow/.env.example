# ==============================================================================
# airflow/.env.example - Airflow Local Environment Template
# Copy this file to airflow/.env:
#   cp airflow/.env.example airflow/.env
# ==============================================================================

AIRFLOW_UID=50000
AIRFLOW_DB_PASSWORD=airflow
AIRFLOW__CORE__FERNET_KEY=46BKJoQYlPPOexq0OhDZnIlNepKFf87WFwLbfzqnzq8=

# Airbyte OSS Integration (from host machine)
AIRBYTE_API_URL=http://host.docker.internal:8000/api/v1
AIRBYTE_CLIENT_ID=your_airbyte_client_id_here
AIRBYTE_CLIENT_SECRET=your_airbyte_client_secret_here
AIRBYTE_CONNECTION_ID=your_airbyte_connection_id_here

# Redshift Serverless Warehouse Configuration (forwarded to dbt runner)
REDSHIFT_HOST=olist-workgroup.123456789012.ap-south-1.redshift-serverless.amazonaws.com
REDSHIFT_PORT=5439
REDSHIFT_DB=dev
REDSHIFT_DBT_USER=dbt_user
REDSHIFT_DBT_PASSWORD=your_dbt_user_password_here

